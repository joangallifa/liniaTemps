# Base de dades (Vercel Postgres / Neon) — Vercel les injecta soles
# quan connectes una base de dades des del dashboard del projecte.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Emmagatzematge de fotos (Vercel Blob) — es genera en crear
# un "Blob store" des del dashboard de Vercel.
BLOB_READ_WRITE_TOKEN=

# Autenticació (Auth.js). Genera'l amb: npx auth secret
AUTH_SECRET=

# Enviament dels magic links (SendGrid, amb Single Sender Verification —
# no cal accés al DNS del domini). Crea un compte a sendgrid.com,
# verifica una única adreça remitent (Settings > Sender Authentication >
# Single Sender Verification) i genera una API key amb permís "Mail Send".
AUTH_SENDGRID_KEY=
EMAIL_FROM=jgallifa@umanresa.cat
EMAIL_FROM_NAME="Línia del temps tecnològica"

# Domini de correu permès per iniciar sessió
ALLOWED_EMAIL_DOMAIN=umanresa.cat
