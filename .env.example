# Base de dades (Vercel Postgres / Neon) — Vercel les injecta soles
# quan connectes una base de dades des del dashboard del projecte.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Emmagatzematge de fotos (Vercel Blob) — es genera en crear
# un "Blob store" des del dashboard de Vercel.
BLOB_READ_WRITE_TOKEN=

# Autenticació (Auth.js). Genera'l amb: npx auth secret
AUTH_SECRET=

# Enviament dels magic links (Resend). Crea un compte a resend.com,
# verifica un domini i genera una API key.
AUTH_RESEND_KEY=
EMAIL_FROM="Línia del temps <no-reply@el-teu-domini.cat>"

# Domini de correu permès per iniciar sessió
ALLOWED_EMAIL_DOMAIN=umanresa.cat
